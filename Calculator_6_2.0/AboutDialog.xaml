<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Calculator.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="О программе" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E5000000">
    <Border CornerRadius="10" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="О калькуляторе" 
                       FontSize="24" FontWeight="Bold" Margin="10"
                       Foreground="#FF5885A4" TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#FF5885A4"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,5" 
                           Foreground="White" FontSize="14">
                    Это простой калькулятор, созданный с использованием WPF и шаблона проектирования MVVM.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5" 
                           Foreground="White" FontSize="14">
                    Версия: 1.0
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5" 
                           Foreground="White" FontSize="14">
                    © 2025 ООО "Калькулятор"
                </TextBlock>
            </StackPanel>

            <Button Grid.Row="2" Content="Выход" HorizontalAlignment="Center" 
                    Margin="10" Padding="20,5" Name="CloseButton"
                    Style="{StaticResource MaterialDesignRaisedAccentButton}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>